		"@tailwindcss/typography": "^0.5.14",
		"autoprefixer": "^10.4.20",
		"cookie": "^2.0.1",
		"mdsvex": "^0.12.8",
		"postcss": "^8.4.41",
		"postcss-import": "^16.1.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
