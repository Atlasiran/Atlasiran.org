{
	"name": "atlas",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"test": "node --test tests/*.test.js",
		"build": "npm run build:constitutions && python3 deploy/md_to_json.py src/content/org-pages --output static/data/data.json && vite build",
		"build:constitutions": "python3 modules/constitutions/pipeline/build_module.py --out static/modules/constitutions",
